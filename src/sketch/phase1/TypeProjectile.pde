
class TypeProjectile {
  final String nom;
  final double masse;
  final double vitesseInitiale;
  final int couleur;
  final float taille;

  TypeProjectile(String nom, double masse, double vitesseInitiale, int couleur, float taille) {
    this.nom = nom;
    this.masse = masse;
    this.vitesseInitiale = vitesseInitiale;
    this.couleur = couleur;
    this.taille = taille;
  }
}
